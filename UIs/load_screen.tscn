bbcode_enabled = true
text = "[center]What the fuck did you just fucking say about me, you weapon? I'll have you know I graduated top of my class in the top secret government labs, and I've been involved in numerous secret raids on Malarkey Labs, and I have over 300 confirmed kills. I am trained in gorilla warfare and I'm the top sniper in the entire US armed forces. You are nothing to me but just another target. I will wipe you the fuck out with precision the likes of which has never been seen before in Nogoode, mark my fucking words. You think you can get away with saying that shit to me over the intercom? Think again, fucker. As we speak I am contacting my secret network of spies across the USA and your IP is being traced right now so you better prepare for the storm, maggot. The storm that wipes out the pathetic little thing you call your life. You're fucking dead, revenant. I can be anywhere, anytime, and I can kill you in over seven hundred ways, and that's just with my bare railgun hands. Not only am I extensively trained in combat, but I have access to the entire arsenal of the United States Military and I will use it to its full extent to wipe your miserable ass off the face of the continent, you little shit. If only you could have known what unholy retribution your little \"clever\" comment was about to bring down upon you, maybe you would have held your fucking guns. But you couldn't, you didn't, and now you're paying the price, you goddamn idiot. I will shit fury all over you and you will drown in it. You're fucking dead, Shotgun Hands"
fit_content = true

[node name="24" type="RichTextLabel" parent="ScrollContainer/VBoxContainer"]
visible = false
layout_mode = 2
